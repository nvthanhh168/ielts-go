# ==============================================================================
# IELTS MASTER AI - BACKEND ENVIRONMENT EXAMPLE
# ==============================================================================

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# AI Configuration
AI_API_KEY="YOUR_AI_API_KEY_HERE"
AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_MODEL_NAME="gemini-1.5-pro"
AI_REQUEST_TIMEOUT_MS=30000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ielts_master_db?schema=public"

# Auth
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

LOG_LEVEL="debug"
